# --- Compose-level environment ------------------------------------------------
#
# This file is read by `docker compose` to fill in the ${VAR} placeholders in
# docker-compose.yml. Copy it to `.env` (same folder) and fill in your real
# values; the real `.env` is git-ignored.
#
#     cp .env.example .env
#
# Used by both local dev and the EC2 Blue / Prod deployments (see README §8).

# Required for the backend to actually talk to OpenAI. Without it the API
# still boots and /health works, but POST /api/food-tier returns a 502
# explaining how to set the key.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the OpenAI chat model. Default in code: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# --- Image coordinates --------------------------------------------------------
# These are interpolated into the `image:` lines of docker-compose.yml:
#     ${ECR_REGISTRY}/food-tier-backend:${IMAGE_TAG}
#
# Local dev (this file's defaults): the freshly built images are tagged
#     localdev/food-tier-{backend,frontend}:local
# (no real ECR pulls happen locally — `docker compose up --build` rebuilds
# from source, so the `localdev` value is just a placeholder.)
#
# On EC2 the real value comes from `terraform output ecr_registry_url`,
# e.g. 123456789012.dkr.ecr.il-central-1.amazonaws.com:
#     ECR_REGISTRY=<acct>.dkr.ecr.<region>.amazonaws.com
#     IMAGE_TAG=staging      # on Blue EC2
#     IMAGE_TAG=prod         # on Prod EC2
ECR_REGISTRY=localdev
IMAGE_TAG=local
