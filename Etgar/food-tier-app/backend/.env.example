# --- Backend environment ------------------------------------------------------
#
# Only needed when running the backend DIRECTLY (without Docker), e.g.:
#
#     cd backend
#     cp .env.example .env
#     # edit .env, paste your real key
#     uvicorn main:app --reload --port 8000
#
# When running via `docker compose up`, the key is injected from
# `../.env` (next to docker-compose.yml) and this file is ignored.

OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override the OpenAI chat model. Default in code: gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
